# Copy to backend/.env and adjust.
ENV=dev
DATABASE_URL=postgresql+psycopg://dukaanos:dukaanos@localhost:5432/dukaanos
TEST_DATABASE_URL=postgresql+psycopg://dukaanos:dukaanos@localhost:5432/dukaanos_test
# Required (and must be changed) when ENV=prod. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me-before-deploying
JWT_EXPIRE_MINUTES=10080
# Unset = Secure cookies only when ENV=prod
# COOKIE_SECURE=true
CORS_ORIGINS=["http://localhost:5173"]
# Vision (Counter "Vision counter" + "Add from photo"): real | none.  Default: real.
#   real = local computer vision on the uploaded camera image: OWL-ViT finds packets, RapidOCR
#          reads the text printed on them, CLIP compares each packet with the logged-in merchant's
#          own catalog names and reference photos. The catalog supplies name and price.
#          No API key, no cloud: images never leave this machine.
#          Needs the optional extra, then run the server with it:
#            uv sync --extra vision
#            uv run --extra vision fastapi dev app/main.py
#          Model weights (~1.2 GB) download from Hugging Face on first use.
#   none = vision switched off. There is no mock: if "real" cannot run, the API answers 503.
# VISION_PROVIDER=real
# VISION_REAL_DEVICE=cpu                       # or cuda (needs a CUDA build of torch)
# VISION_REAL_LOCATOR_MODEL=google/owlvit-base-patch32
# VISION_REAL_IDENTIFIER_MODEL=openai/clip-vit-base-patch32
# VISION_REAL_PROMPTS=path/to/prompts.json     # default: app/integrations/vision_prompts.json (generic)
# VISION_REAL_MIN_LOCATE_SCORE=0.15            # raise to show fewer, surer boxes
# VISION_REAL_OCR=true                         # false = no text reading (faster, far less reliable)
# VISION_REAL_OCR_SIDE=640                     # OCR resolution: higher reads smaller text, slower
# Catalog matching. Scores are combined evidence (looks + text read on the pack + reference photos), 0..1:
# VISION_MATCH_SCORE=0.75                      # needed to preselect a product; below it: "Unsure. Confirm to add"
# VISION_MIN_SCORE=0.35                        # below this nothing in the catalog is supported: "Not in catalog"
# VISION_MATCH_MARGIN=0.15                     # two catalog products closer than this -> "Which product is it?"
# VISION_REFERENCE_FLOOR=0.65                  # reference-photo similarity that counts as no support...
# VISION_REFERENCE_STRONG=0.85                 # ...and as full support
# Diagnosis only (stores camera images on disk; leave unset normally). Per recognized image it writes
# frame.jpg, boxes.jpg, crop_<n>.jpg and trace.json (detector boxes, crop coordinates, OCR lines and
# which box got them, CLIP scores for every catalog product, fusion scores, decision):
# VISION_DEBUG_DIR=vision-debug

# Parchi (Counter "Add from Parchi"): ocr | none.  Default: ocr.
#   ocr  = local OCR (RapidOCR) on the uploaded photo; each line is then matched to the logged-in
#          merchant's own catalogue. No API key, no cloud: the photo never leaves this machine.
#          Needs the optional extra:  uv sync --extra parchi   (already included in --extra vision)
#   none = parchi reading switched off. There is no mock: if "ocr" cannot run, the API answers 503.
# PARCHI_PROVIDER=ocr
