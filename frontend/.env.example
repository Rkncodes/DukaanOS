# Leave empty in dev: Vite proxies /api to http://localhost:8000.
# Set to the API origin when the frontend is hosted separately.
VITE_API_BASE_URL=

# Address customers use to reach the storefront; the Shop QR code encodes <this>/store/<slug>.
# Leave empty to use the address the merchant's browser shows. A phone cannot open "localhost":
# for a phone on the same Wi-Fi, run `npm run dev -- --host` and set e.g. http://192.168.1.20:5173
VITE_STOREFRONT_ORIGIN=
